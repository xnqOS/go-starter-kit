HTTP_ADDR=:8080
STORAGE=sqlite
DATABASE_URL=./data/app.db
# For PostgreSQL, change BOTH settings:
# STORAGE=postgres
# DATABASE_URL=postgres://starter:starter@localhost:5432/starter?sslmode=disable
# STORAGE=memory is also supported for disposable data; it needs no database.
GIN_MODE=release
# Reverse proxies (comma-separated IPs or CIDRs) whose X-Forwarded-For is
# trusted for the client IP. Leave empty when the API is reached directly.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8

# Each application should choose its own LOG_SERVICE (Syslog APP-NAME).
LOG_SERVICE=starter-kit
LOG_ENV=development
LOG_LEVEL=info
LOG_OUTPUTS=stdout
# LOG_INSTANCE defaults to the machine/container hostname.

# Set LOG_OUTPUTS=stdout,syslog to send logs to the central server too.
LOG_SYSLOG_ADDRESS=127.0.0.1:5140
LOG_SYSLOG_NETWORK=tcp
LOG_SYSLOG_FACILITY=local0
LOG_SYSLOG_TIMEOUT=500ms
# For a remote TLS server:
# LOG_SYSLOG_NETWORK=tls
# LOG_SYSLOG_ADDRESS=logs.example.com:6514
# LOG_SYSLOG_TLS_CA_FILE=/path/to/private-ca.pem
# LOG_SYSLOG_TLS_SERVER_NAME=logs.example.com

# Optional: a dedicated database for PostgreSQL integration tests.
# TEST_DATABASE_URL=postgres://starter:starter@localhost:5432/starter_test?sslmode=disable
