# Copy to .env.deploy. Used by compose.deploy.yaml; separate from local .env.
HTTP_ADDR=:8080
GIN_MODE=release
# Set when a reverse proxy (Caddy, Nginx, a tunnel) sits in front of the API,
# so rate limits and logs see the real client IP. Comma-separated IPs or CIDRs.
# TRUSTED_PROXY_CIDRS=172.16.0.0/12
STORAGE=sqlite
DATABASE_URL=/app/data/app.db
# For an external PostgreSQL server, change BOTH settings:
# STORAGE=postgres
# DATABASE_URL=postgres://app:password@db.example.com:5432/app?sslmode=verify-full
LOG_SERVICE=starter-kit
LOG_ENV=production
LOG_LEVEL=info
LOG_OUTPUTS=stdout
# LOG_INSTANCE defaults to the hostname (the container ID).
# LOG_INSTANCE=order-api-1
# To send logs to a log server as well (see docs/logging.md):
# LOG_OUTPUTS=stdout,syslog
# LOG_SYSLOG_ADDRESS=logs.example.com:6514
# LOG_SYSLOG_NETWORK=tls
# LOG_SYSLOG_FACILITY=local0
# LOG_SYSLOG_TIMEOUT=500ms
# LOG_SYSLOG_TLS_CA_FILE=/app/certs/ca.crt
# LOG_SYSLOG_TLS_SERVER_NAME=logs.example.com
